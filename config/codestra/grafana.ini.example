# Codestra Grafana application configuration.
# Host-level deployment must publish container port 3000 only on 127.0.0.1.

[server]
protocol = http
http_port = 3000
domain = graf.codestra.media
root_url = https://graf.codestra.media/
enforce_domain = true

[security]
cookie_secure = true
cookie_samesite = lax
disable_gravatar = true

[users]
allow_sign_up = false

[auth]
disable_login_form = true
disable_signout_menu = false

[auth.generic_oauth]
enabled = true
name = Codestra Keycloak
allow_sign_up = false
client_id = grafana-observability
client_secret = $__file{/run/secrets/grafana_oidc_client_secret}
scopes = openid profile email
email_attribute_path = email
login_attribute_path = preferred_username
name_attribute_path = name
auth_url = https://auth.codestra.co/realms/codestra/protocol/openid-connect/auth
token_url = https://auth.codestra.co/realms/codestra/protocol/openid-connect/token
api_url = https://auth.codestra.co/realms/codestra/protocol/openid-connect/userinfo
use_pkce = true
role_attribute_strict = true
allow_assign_grafana_admin = true
role_attribute_path = contains(realm_access.roles[*], 'observability-admin') && 'GrafanaAdmin' || contains(realm_access.roles[*], 'observability-operator') && 'Editor' || contains(realm_access.roles[*], 'observability-viewer') && 'Viewer'
signout_redirect_url = https://auth.codestra.co/realms/codestra/protocol/openid-connect/logout?post_logout_redirect_uri=https%3A%2F%2Fgraf.codestra.media%2F

[auth.anonymous]
enabled = false

[log]
mode = console
level = info
