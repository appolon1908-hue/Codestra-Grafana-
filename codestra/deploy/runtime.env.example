# Non-secret Codestra Grafana deployment contract.
# Secret values are supplied as external runtime secret files and never belong here.

CODESTRA_ENVIRONMENT=staging
CODESTRA_REGION=hetzner-eu
CODESTRA_DEPLOYMENT_ID=replace-with-immutable-release-id

# Every image value must be a complete immutable reference containing @sha256:...
PYTHON_BUILDER_IMAGE=python:3.13-alpine@sha256:REPLACE_WITH_REAL_DIGEST
GRAFANA_BASE_IMAGE=grafana/grafana:REPLACE_WITH_PINNED_VERSION@sha256:REPLACE_WITH_REAL_DIGEST
CODESTRA_GRAFANA_IMAGE=ghcr.io/appolon1908-hue/codestra-grafana:REPLACE_WITH_RELEASE@sha256:REPLACE_WITH_REAL_DIGEST

GRAFANA_HOST_PORT=3000
GF_DATABASE_HOST=postgres-grafana:5432
GF_DATABASE_NAME=grafana

CODESTRA_OBSERVABILITY_NETWORK=codestra-observability
CODESTRA_DATABASE_NETWORK=codestra-database

# External secret object names only. Values are created through OpenBao/deployment authority.
GRAFANA_OIDC_SECRET_NAME=grafana-oidc-client-secret
GRAFANA_DATABASE_USER_SECRET_NAME=grafana-database-user
GRAFANA_DATABASE_PASSWORD_SECRET_NAME=grafana-database-password
GRAFANA_DATABASE_CA_SECRET_NAME=grafana-database-ca
GRAFANA_SECRET_KEY_NAME=grafana-secret-key
